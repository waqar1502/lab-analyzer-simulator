{
  "id": "cbc-normal",
  "name": "CBC - normal range",
  "analyzer_type": "hematology",
  "processing_seconds": 0.2,
  "processing_jitter_seconds": 0.2,
  "tests": {
    "WBC": {"type": "range", "min": 5.0, "max": 8.5, "decimals": 1, "units": "10^9/L", "reference_range": "4.0-10.0"},
    "RBC": {"type": "range", "min": 4.5, "max": 5.5, "decimals": 2, "units": "10^12/L", "reference_range": "4.2-5.9"},
    "HGB": {"type": "range", "min": 13.0, "max": 16.5, "decimals": 1, "units": "g/dL", "reference_range": "12.0-17.5"},
    "HCT": {"type": "range", "min": 40, "max": 48, "decimals": 1, "units": "%", "reference_range": "36-52"},
    "PLT": {"type": "range", "min": 180, "max": 320, "decimals": 0, "units": "10^9/L", "reference_range": "150-400"}
  }
}

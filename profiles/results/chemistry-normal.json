    "ALT": {"type": "range", "min": 12, "max": 38, "decimals": 0, "units": "U/L", "reference_range": "7-56"},
    "AST": {"type": "range", "min": 12, "max": 35, "decimals": 0, "units": "U/L", "reference_range": "10-40"}
  }
}
